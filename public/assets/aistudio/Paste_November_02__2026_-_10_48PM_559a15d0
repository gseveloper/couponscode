// 4. AJAX Front-End User Coupon Submission
function simplycodes_ajax_submit_coupon() {
    check_ajax_referer('sc_nonce', 'nonce');

    $store_id = intval($_POST['store_id'] ?? 0);
    $code     = sanitize_text_field($_POST['code'] ?? '');
    $discount = sanitize_text_field($_POST['discount'] ?? '');
    $desc     = sanitize_textarea_field($_POST['description'] ?? '');

    if (!$store_id || empty($code)) {
        wp_send_json_error('Store and Coupon Code are required.');
    }

    $post_id = wp_insert_post([
        'post_title'   => $discount ? $discount . ' - ' . $code : 'Promo Code: ' . $code,
        'post_content' => $desc,
        'post_status'  => 'draft', // Admin can review before publishing
        'post_type'    => 'coupon'
    ]);

    if (!is_wp_error($post_id)) {
        update_post_meta($post_id, '_coupon_store_id', $store_id);
        update_post_meta($post_id, '_coupon_code', $code);
        update_post_meta($post_id, '_coupon_discount', $discount);
        update_post_meta($post_id, '_coupon_health', 90);
        update_post_meta($post_id, '_coupon_type', 'code');
        update_post_meta($post_id, '_coupon_verified', 'no');

        wp_send_json_success('Thank you! Your coupon has been submitted for verification.');
    } else {
        wp_send_json_error('Error submitting code.');
    }
}
add_action('wp_ajax_sc_submit_coupon', 'simplycodes_ajax_submit_coupon');
