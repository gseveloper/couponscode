    <script>
    (function(){
        var pills=Array.from(document.querySelectorAll('#sdPills .sd-pill'));
        var cards=document.querySelectorAll('#sdGrid .sd-card');
        if(!pills.length)return;

        function activatePill(pill){
            pills.forEach(function(p){
                p.classList.remove('active');
                p.setAttribute('aria-selected','false');
                p.setAttribute('tabindex','-1');
            });
            pill.classList.add('active');
            pill.setAttribute('aria-selected','true');
            pill.setAttribute('tabindex','0');
            pill.focus();
            var cat=pill.getAttribute('data-cat');
            cards.forEach(function(card){
                card.style.display=(card.getAttribute('data-category')===cat)?'':'none';
            });
        }

        pills.forEach(function(pill){
            pill.addEventListener('click',function(){
                activatePill(pill);
            });
            pill.addEventListener('keydown',function(e){
                var idx=pills.indexOf(pill);
                if(e.key==='ArrowRight'||e.key==='ArrowDown'){
                    e.preventDefault();
                    activatePill(pills[(idx+1)%pills.length]);
                }
                if(e.key==='ArrowLeft'||e.key==='ArrowUp'){
                    e.preventDefault();
                    activatePill(pills[(idx-1+pills.length)%pills.length]);
                }
                if(e.key==='Home'){
                    e.preventDefault();
                    activatePill(pills[0]);
                }
                if(e.key==='End'){
                    e.preventDefault();
                    activatePill(pills[pills.length-1]);
                }
            });
        });
    })();
