            el.addEventListener('pointerenter', function () { loadNavIsland(); }, { once: true, passive: true });
            el.addEventListener('touchstart', function () { loadNavIsland(); }, { once: true, passive: true });
            el.addEventListener('focusin', function () { loadNavIsland(); }, { once: true });
        }

        function gateFirstClick(el) {
            if (!el) return;
            el.addEventListener('click', function onFirstClick(event) {
                if (loaded || failed) return;
                event.preventDefault();
                event.stopPropagation();
                loadNavIsland(function () {
                    requestAnimationFrame(function () {
                        if (el instanceof HTMLElement) el.click();
                    });
                });
            }, { capture: true, once: true });
        }

        primeOnInteraction(document.querySelector('.find-deals-wrapper'));
        primeOnInteraction(document.querySelector('.mobile-fd-trigger'));
        primeOnInteraction(document.querySelector('.hamburger-btn'));

        gateFirstClick(document.querySelector('.mobile-fd-trigger'));
        gateFirstClick(document.querySelector('.hamburger-btn'));

        if ('requestIdleCallback' in window) {
            window.requestIdleCallback(function () { loadNavIsland(); }, { timeout: 3000 });
        } else {
            setTimeout(function () { loadNavIsland(); }, 1500);
