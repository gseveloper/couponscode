    if (window.innerWidth < 768) {
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-short-placeholder]').forEach(function(el) {
                el.placeholder = el.getAttribute('data-short-placeholder');
            });
        });
    }
    </script>



    
