        // ── Search modal ──────────────────────────────────────────────────────
        (function initSearch() {
            function getStoreBase() { return window.__scStoreBase || 'https://simplycodes.com/store/'; }
            var trigger = document.getElementById('search-trigger');
            var closeBtn = document.getElementById('search-close');
            var findBtn = document.getElementById('search-find-btn');
            var overlay = document.getElementById('search-overlay');
            var panel = document.getElementById('search-panel');
            var input = document.getElementById('search-input');
            var container = document.getElementById('search-results-container');
            if (!trigger || !panel || !input || !container) return;

            var popularCache = null;
            var trendingCache = null;
            var categoriesCache = null;
            var debounceTimer = null;
            var focusIndex = -1;

            function escHtml(str) {
                return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
            }

            function pluralize(n, word) {
                return n === 1 ? n + ' ' + word : n + ' ' + word + 's';
            }

            // Read categories from the nav DOM (already SSR-rendered)
            function getCategories() {
                if (categoriesCache) return categoriesCache;
                var cats = [];
                document.querySelectorAll('#fd-cat-wrapper [data-slug][data-name]').forEach(function (el) {
                    var slug = el.getAttribute('data-slug');
                    var name = el.getAttribute('data-name');
                    if (slug && name) cats.push({ slug: slug, name: name });
                });
                categoriesCache = cats.slice(0, 16);
                return categoriesCache;
            }

            function openSearch() {
                panel.classList.add('open');
                overlay.classList.add('open');
                trigger.classList.add('open');
                trigger.setAttribute('aria-expanded', 'true');
                document.body.style.overflow = 'hidden';
                setTimeout(function () { input.focus(); }, 50);
                if (!popularCache || !trendingCache) loadPreSearch();
                else showPreSearch(popularCache, trendingCache, getCategories());
            }

            function closeSearch() {
                panel.classList.remove('open');
                overlay.classList.remove('open');
                trigger.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
                document.body.style.overflow = '';
                input.value = '';
                focusIndex = -1;
            }

            function renderSkeleton() {
                var skels = '';
                for (var i = 0; i < 6; i++) {
                    skels += '<div class="search-skeleton-row"><div class="search-skeleton-logo"></div><div class="search-skeleton-lines"><div class="search-skeleton-line"></div><div class="search-skeleton-line short"></div></div></div>';
                }
                container.innerHTML = '<div class="search-loading">' + skels + '</div>';
            }

            function renderPopularCard(m) {
                var codesText = m.codes > 0 ? pluralize(m.codes, 'code') : 'Promo codes';
                return '<a href="' + getStoreBase() + escHtml(m.slug) + '" class="search-popular-card">' +
                    '<div class="search-popular-name">' + escHtml(m.name) + '</div>' +
                    '<div class="search-popular-codes">' + escHtml(codesText) + '</div>' +
                    '</a>';
            }

            function renderTrendingItem(m) {
                var initials = (m.name || 'SC').substring(0, 2).toUpperCase();
                var logoHtml = m.logo
                    ? '<img class="search-trending-logo" src="' + escHtml(m.logo) + '" alt="" loading="lazy">' +
                      '<div class="search-trending-logo-fallback" style="display:none">' + escHtml(initials) + '</div>'
                    : '<div class="search-trending-logo-fallback">' + escHtml(initials) + '</div>';
                var subtext = m.averageSavings || (m.codes > 0 ? pluralize(m.codes, 'code') : '');
                return '<a href="' + getStoreBase() + escHtml(m.slug) + '" class="search-trending-item">' +
                    logoHtml +
                    '<div class="search-trending-info">' +
                    '<div class="search-trending-name">' + escHtml(m.name) + '</div>' +
                    (subtext ? '<div class="search-trending-discount">' + escHtml(subtext) + '</div>' : '') +
                    '</div>' +
                    '</a>';
            }

            function showPreSearch(popular, trending, categories) {
                var html = '<div class="search-pre-view">';
                if (popular && popular.length) {
                    html += '<div><div class="search-section-title">Popular stores</div>';
                    html += '<div class="search-popular-grid">' + popular.map(renderPopularCard).join('') + '</div></div>';
                }
                if (trending && trending.length) {
                    html += '<div><div class="search-section-title">Trending coupons</div>';
                    html += '<div class="search-trending-grid">' + trending.map(renderTrendingItem).join('') + '</div></div>';
                }
                if (categories && categories.length) {
                    html += '<div><div class="search-section-title">Categories</div><div class="search-cat-list">';
                    html += categories.map(function (c) {
                        return '<a href="https://simplycodes.com/category/' + escHtml(c.slug) + '" class="search-cat-item">' + escHtml(c.name) + '</a>';
                    }).join('');
                    html += '</div></div>';
                }
                html += '</div>';
                container.innerHTML = html;
            }

            function loadPreSearch() {
                renderSkeleton();
                var catData = getCategories();
                var popularDone = false, trendingDone = false;
                var popData = null, trendData = null;

                function tryRender() {
                    if (popularDone && trendingDone && !input.value.trim()) {
                        popularCache = popData || [];
                        trendingCache = trendData || [];
                        showPreSearch(popularCache, trendingCache, catData);
                    }
                }

                fetch('/api/merchants/popular')
                    .then(function (r) { return r.ok ? r.json() : { merchants: [] }; })
                    .then(function (data) { popData = (data.merchants || []).slice(0, 8); popularDone = true; tryRender(); })
                    .catch(function () { popData = []; popularDone = true; tryRender(); });

                fetch('/api/merchants/trending')
                    .then(function (r) { return r.ok ? r.json() : { merchants: [] }; })
                    .then(function (data) { trendData = (data.merchants || []).slice(0, 8); trendingDone = true; tryRender(); })
                    .catch(function () { trendData = []; trendingDone = true; tryRender(); });
            }

            function renderMerchantRow(m, idx) {
                var initials = (m.name || 'SC').substring(0, 2).toUpperCase();
                var logoHtml = m.logo
                    ? '<img class="search-result-logo" src="' + escHtml(m.logo) + '" alt="" loading="lazy">' +
                      '<div class="search-result-logo-fallback" style="display:none">' + escHtml(initials) + '</div>'
                    : '<div class="search-result-logo-fallback">' + escHtml(initials) + '</div>';
                var badgeClass = m.codes > 0 ? 'search-result-badge has-codes' : 'search-result-badge';
                var badgeText = m.codes > 0 ? pluralize(m.codes, 'code') : 'Codes';
                return '<a href="' + getStoreBase() + escHtml(m.slug) + '" class="search-result-row" data-idx="' + idx + '">' +
                    logoHtml +
                    '<div class="search-result-text"><div class="search-result-name">' + escHtml(m.name) + '</div></div>' +
                    '<div class="' + badgeClass + '">' + escHtml(badgeText) + '</div>' +
                    '</a>';
            }

            function showSearchLoading() {
                var skels = '';
                for (var i = 0; i < 6; i++) {
                    skels += '<div class="search-skeleton-row"><div class="search-skeleton-logo"></div><div class="search-skeleton-lines"><div class="search-skeleton-line"></div><div class="search-skeleton-line short"></div></div></div>';
                }
                container.innerHTML = '<div class="search-loading">' + skels + '</div>';
            }

            function showResults(merchants, query) {
                if (!merchants || !merchants.length) {
                    container.innerHTML = '<div class="search-no-results">No results for &ldquo;' + escHtml(query) + '&rdquo;</div>';
                    return;
                }
                container.innerHTML = merchants.map(renderMerchantRow).join('');
            }

            function doSearch(query) {
                showSearchLoading();
                fetch('/api/merchants/autocomplete?q=' + encodeURIComponent(query))
                    .then(function (r) { return r.ok ? r.json() : { suggestions: [] }; })
                    .then(function (data) { showResults(data.suggestions || [], query); })
                    .catch(function () { container.innerHTML = '<div class="search-no-results">Search unavailable</div>'; });
            }

            function updateFocus() {
                container.querySelectorAll('.search-result-row').forEach(function (el, i) {
                    el.classList.toggle('focused', i === focusIndex);
                });
            }

            trigger.addEventListener('click', function () {
                panel.classList.contains('open') ? closeSearch() : openSearch();
            });

            // Mobile menu search button — close hamburger then open search
            var mobileSearchBtn = document.getElementById('mobile-search-trigger');
            if (mobileSearchBtn) {
                mobileSearchBtn.addEventListener('click', function () {
                    var hamburger = document.querySelector('.hamburger-btn');
                    var mobileMenu = document.querySelector('.mobile-menu');
                    if (hamburger && mobileMenu) {
                        mobileMenu.classList.remove('open');
                        hamburger.classList.remove('open');
                        hamburger.setAttribute('aria-expanded', 'false');
                    }
                    openSearch();
                });
            }
            closeBtn && closeBtn.addEventListener('click', closeSearch);
            overlay.addEventListener('click', closeSearch);
            findBtn && findBtn.addEventListener('click', function () {
                var q = input.value.trim();
                if (q) { clearTimeout(debounceTimer); doSearch(q); }
                else input.focus();
            });

            input.addEventListener('input', function () {
                var q = input.value.trim();
                clearTimeout(debounceTimer);
                focusIndex = -1;
                if (!q) {
                    if (popularCache && trendingCache) showPreSearch(popularCache, trendingCache, getCategories());
                    return;
                }
                debounceTimer = setTimeout(function () { doSearch(q); }, 280);
            });

            input.addEventListener('keydown', function (e) {
                var rows = container.querySelectorAll('.search-result-row');
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    focusIndex = Math.min(focusIndex + 1, rows.length - 1);
                    updateFocus();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    focusIndex = Math.max(focusIndex - 1, -1);
                    updateFocus();
                } else if (e.key === 'Enter' && focusIndex >= 0 && rows[focusIndex]) {
                    e.preventDefault();
                    rows[focusIndex].click();
                } else if (e.key === 'Escape') {
                    closeSearch();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && panel.classList.contains('open')) closeSearch();
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    panel.classList.contains('open') ? closeSearch() : openSearch();
                }
            });
        })();
        // ── End search modal ──────────────────────────────────────────────────
    })();

