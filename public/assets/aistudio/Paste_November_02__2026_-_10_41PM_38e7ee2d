(function () {
    var mq = window.matchMedia('(max-width: 767px)');
    document.querySelectorAll('.footer-col').forEach(function (col) {
        var btns = col.querySelectorAll('.footer-col-title');
        var lists = col.querySelectorAll('.footer-col-links');
        btns.forEach(function (btn, i) {
            var list = lists[i];
            if (!btn || !list) return;
            function syncAriaExpanded() {
                if (mq.matches) {
                    if (!btn.hasAttribute('aria-expanded')) {
                        btn.setAttribute('aria-expanded', 'false');
                    }
                } else {
                    btn.removeAttribute('aria-expanded');
                    list.classList.remove('open');
                }
            }
            syncAriaExpanded();
            mq.addEventListener('change', syncAriaExpanded);
            btn.addEventListener('click', function () {
                if (!mq.matches) return;
                var expanded = btn.getAttribute('aria-expanded') === 'true';
                btn.setAttribute('aria-expanded', String(!expanded));
                list.classList.toggle('open', !expanded);
            });
        });
    });
}());
</script>


  
  
