  // Exposed on window so show-more onclick can re-run after revealing hidden tips.
  window._initTipExpandBtns=function(){
    var bodies=document.querySelectorAll('[data-tip-body]');
    for(var i=0;i<bodies.length;i++){
      var body=bodies[i];
      if(body.scrollHeight>body.clientHeight+2){
        var btn=body.nextElementSibling;
        if(btn&&btn.hasAttribute('data-tip-expand')){btn.style.display='flex';}
      }
    }
  };
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',window._initTipExpandBtns);}
  else{window._initTipExpandBtns();}
  // Comments toggle
  document.addEventListener('click',function(e){
    var btn=e.target.closest&&e.target.closest('[data-tip-comments-btn]');
    if(!btn)return;
    var tipId=btn.getAttribute('data-tip-comments-btn');
    if(!tipId)return;
    var panel=document.getElementById('tip-comments-'+tipId);
    if(!panel)return;
    panel.style.display=panel.style.display==='none'?'block':'none';
  });
  document.addEventListener('click',function(e){
    var target=e.target;
    // STEP 1: Resolve the tip body element from whatever was clicked.
    // WHY: Click may land on the SVG inside the chevron button, on the button itself,
    // or directly on the paragraph — walk up to find the article then query.
    var tipBody=null;
    var expandBtn=null;
    if(target&&target.closest){
      var btn=target.closest('[data-tip-expand]');
      if(btn){
        expandBtn=btn;
        var article=btn.closest('article');
        if(article){tipBody=article.querySelector('[data-tip-body]');}
      } else {
        var body=target.closest('[data-tip-body]');
        if(body){
          tipBody=body;
          var article2=body.closest('article');
          if(article2){expandBtn=article2.querySelector('[data-tip-expand]');}
        }
      }
    }
    if(!tipBody){return;}
    // STEP 2: Toggle clamped vs expanded state.
    // WHY: data-expanded attribute is the single source of truth for current state.
    var isExpanded=tipBody.getAttribute('data-expanded')==='true';
    if(isExpanded){
      // Collapse back to 1-line clamp
      tipBody.style.display='-webkit-box';
      tipBody.style.webkitLineClamp='1';
      tipBody.style.webkitBoxOrient='vertical';
      tipBody.style.overflow='hidden';
      tipBody.setAttribute('data-expanded','false');
      if(expandBtn){expandBtn.style.transform='rotate(0deg)';}
    } else {
      // Expand to full text
      tipBody.style.display='block';
      tipBody.style.webkitLineClamp='unset';
      tipBody.style.webkitBoxOrient='initial';
      tipBody.style.overflow='visible';
      tipBody.setAttribute('data-expanded','true');
      if(expandBtn){expandBtn.style.transform='rotate(180deg)';}
    }
  });
})();</script>

