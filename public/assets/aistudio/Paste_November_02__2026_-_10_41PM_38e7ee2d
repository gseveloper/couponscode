(function () {
  // GUARD: run only once even if script is duplicated across partial renders
  if (window._reviewExpandInit) return;
  window._reviewExpandInit = true;

  function initClamps() {
    // STEP 1: Find every review body paragraph on the page
    var bodies = document.querySelectorAll('[data-review-body]');

    for (var i = 0; i < bodies.length; i++) {
      var body = bodies[i];
      // STEP 2: Overflow check — scrollHeight > clientHeight means text is clamped
      // WHY: The browser only reports the true scrollHeight after the clamp style
      //      is applied, so this check is accurate at DOMContentLoaded.
      if (body.scrollHeight > body.clientHeight) {
        var btn = body.nextElementSibling;
        // STEP 3: Reveal the "Read more" button only when overflow is detected
        if (btn && btn.hasAttribute('data-read-more')) {
          btn.style.display = 'block';
        }
      }
    }
  }

  // STEP 4: Delegate click handling so dynamically-inserted cards work too
  document.addEventListener('click', function (e) {
    var target = e.target;
    if (!target || !target.hasAttribute || !target.hasAttribute('data-read-more')) return;

    var btn = target;
    var body = btn.previousElementSibling;
    if (!body || !body.hasAttribute('data-review-body')) return;

    var isClamped = body.style.webkitLineClamp !== 'unset' && body.style.overflow !== 'visible';

    if (isClamped) {
      // EXPAND: remove clamp styles, update button label
      body.style.overflow = 'visible';
      body.style.webkitLineClamp = 'unset';
      body.style.display = 'block';
      btn.textContent = 'Read less';
    } else {
      // COLLAPSE: restore clamp styles, update button label
      body.style.display = '-webkit-box';
      body.style.webkitLineClamp = '4';
      body.style.overflow = 'hidden';
      btn.textContent = 'Read more';
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClamps);
  } else {
    // DOMContentLoaded already fired (e.g. script injected late)
    initClamps();
  }
})();
</script>

    
<script>
(function(){
  if(window._reviewShowMoreInit)return;
  window._reviewShowMoreInit=true;
  document.addEventListener('click',function(e){
    var btn=e.target.closest('[data-review-show-more]');
    if(!btn)return;
    var sectionId=btn.getAttribute('data-review-show-more');
    var hidden=document.getElementById(sectionId);
    if(!hidden)return;
    var isOpen=btn.getAttribute('data-open')==='1';
    if(isOpen){
      hidden.style.display='none';
      btn.textContent='Show more reviews';
      btn.setAttribute('data-open','0');
    } else {
      hidden.style.display='contents';
      btn.textContent='Show less';
      btn.setAttribute('data-open','1');
      // Re-run clamp detection for newly visible cards — initClamps() ran at
      // DOMContentLoaded when these were display:none (scrollHeight=0), so
      // "Read more" buttons were never enabled. Use rAF to wait for layout.
      requestAnimationFrame(function(){
        var bodies=hidden.querySelectorAll('[data-review-body]');
        for(var i=0;i<bodies.length;i++){
          var body=bodies[i];
          if(body.scrollHeight>body.clientHeight){
            var readMoreBtn=body.nextElementSibling;
            if(readMoreBtn&&readMoreBtn.hasAttribute('data-read-more'))readMoreBtn.style.display='block';
          }
        }
      });
    }
  });
})();
</script>
  
