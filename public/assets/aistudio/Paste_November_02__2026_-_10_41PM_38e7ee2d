    img.onload=function(){spinner.style.display='none';img.style.display='block';};
    img.onerror=function(){spinner.textContent='Image could not be loaded.';};
    img.src=src;
  }
  function closeModal(){
    modal.style.display='none';
    modal.setAttribute('aria-hidden','true');
    img.src='';
    document.body.style.overflow=prevOverflow;
    // Remove ?ss= from URL without reloading
    if(location.search){
      var p=new URLSearchParams(location.search);
      if(p.has('ss')){p.delete('ss');var qs=p.toString();history.replaceState(null,'',location.pathname+(qs?'?'+qs:''));}
