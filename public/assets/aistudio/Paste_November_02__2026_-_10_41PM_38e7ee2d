  } // end if(modal)

  // Reveal every code on the page at once: the main Show Code buttons AND the
  // verification-activity tokens (per-card feed [data-show-code-trigger] + community
  // dashboard [data-copy-code]), which render a "{Merchant} promo code" placeholder until
  // reveal so the literal code stays out of the SSR HTML that Google indexes. Mirrors the
  // live MerchantStore.showCodes = true behaviour. Idempotent via the data-revealed guard.
  function revealAllCodes(){
    document.querySelectorAll('.btn-show-code').forEach(function(b){
      if(b.dataset.revealed==='1')return;
      var c=b.dataset.code||'';
      if(!c)return;
      b.textContent=c.toUpperCase();
      b.style.background='transparent';
      b.style.border='1px solid #4E5255';
      b.style.color='#03FF88';
      b.style.fontSize='14px';
      b.dataset.revealed='1';
    });
    document.querySelectorAll('[data-show-code-trigger],[data-copy-code]').forEach(function(s){
      if(s.dataset.revealed==='1')return;
      var c=s.dataset.code||s.dataset.copyCode||'';
      if(!c)return;
      s.textContent=c.toUpperCase();
      s.style.textTransform='uppercase';
      s.dataset.revealed='1';
    });
  }
  // Expose so cross-component inline handlers (the community dashboard's [data-copy-code]
  // token, which stops propagation and never reaches this document-level handler) can
  // trigger the same page-wide reveal as a Show Code button instead of revealing only themselves.
  try{window.__scRevealAllCodes=revealAllCodes;}catch(e){}

  // Whole-card clickable: click on card article delegates to its Show Code button
  document.addEventListener('click',function(e){
    var card=e.target.closest('.coupon-card-enhanced');
    if(!card)return;
    if(e.target.closest('button,a,[role="button"],[data-cc-expand],[data-activity-show-more],[data-show-code-trigger]'))return;
    var showBtn=card.querySelector('.btn-show-code');
    if(showBtn)showBtn.click();
  });

  // Show Code button handler
  document.addEventListener('click',function(e){
    var btn=e.target.closest('.btn-show-code,[data-show-code-trigger]');
    if(!btn)return;
    e.stopPropagation();

    var code=btn.dataset.code||'';

    // Copy NOW, synchronously, while we still hold the click gesture and before the
    // pop-under navigation below can abort an async clipboard write. (Fixes: bubble
    // said "Copied!" but clipboard was empty until a second click.)
    if(code)scCopySync(code);

    var merchantUrl=btn.dataset.merchantUrl||'';
    var merchantName=btn.dataset.merchantName||'store';
    var merchantLogo=btn.dataset.merchantLogo||'';
    var title=btn.dataset.title||'';
    var description=btn.dataset.description||'';
    var pageSection=btn.dataset.pageSection||'';
    var order=parseInt(btn.dataset.order||'0',10)||null;
    var health=btn.dataset.health||'';
    var healthScore=btn.dataset.healthScore||'';
    var codeType=btn.dataset.codeType||'Regular';
    var discount=btn.dataset.discount||title;
    var restrictions=[];
    try{restrictions=JSON.parse(btn.dataset.restrictions||'[]');}catch(ex){}

    // Build affiliate URL
    if(!window._scOpenedAffiliates)window._scOpenedAffiliates=new Set();
    var layoutEl=document.querySelector('[data-component="mlp-v2-layout"]');
    var pageMerchantId=parseInt(layoutEl&&layoutEl.dataset.merchantId||'0',10);
    // Strip cc- or su- prefix to get numeric promoId (e.g. "cc-1234" or "su-1234" → "1234").
    // Non-numeric prefixes (cs- for career cards, cd- for competitor cards) intentionally
    // produce NaN from parseInt, skipping the promotion-redirect branch.
    // Career cards always supply data-override-affiliate-url so affiliateUrl is set
    // before the promoId branch is even evaluated.
    var promoId=(btn.dataset.couponId||'').replace(/^(?:cc|su)-/,'');
    var originUrl=encodeURIComponent(location.href.split('?')[0]);
    var affiliateUrl='';
    // data-override-affiliate-url: used by competitor/career/reseller cards to bypass merchant redirect
    if(btn.dataset.overrideAffiliateUrl){
      affiliateUrl=btn.dataset.overrideAffiliateUrl;
      // Append origin-url dynamically to SC redirector URLs (can't be pre-rendered server-side)
      if(affiliateUrl.indexOf('/v1/redirect/')>=0&&affiliateUrl.indexOf('origin-url')<0){
        affiliateUrl+='&origin-url='+originUrl;
      }
    }else if(promoId&&!isNaN(parseInt(promoId,10))){
      affiliateUrl='https://api.simplycodes.com/v1/redirect/promotion/'+promoId+'?origin=scmdp&origin-url='+originUrl;
    }else if(pageMerchantId){
      affiliateUrl='https://api.simplycodes.com/v1/redirect/merchant/'+pageMerchantId+'?origin=scmdp&origin-url='+originUrl;
    }else{
      affiliateUrl=merchantUrl;
    }

    // 1. Reveal all codes on first interaction — the clicked button/token plus every other
    //    Show Code button and verification-activity token. Mirrors MerchantStore.showCodes.
    if(code&&btn.dataset.revealed!=='1'){
      revealAllCodes();
    }

    // 2. Pop-under: open blank popup BEFORE clipboard write so the user gesture is
    //    consumed by window.open() first — clipboard.writeText() is async and will
    //    exhaust the gesture token in Safari / strict popup-blocking browsers if called
    //    first, causing the popup to be silently blocked.
    //    Order: window.open() → popup.location.assign(mlpUrl) → location.href = affiliate.
    //    Once per page load per merchant. Falls back to showing modal on current tab
    //    if the popup is blocked.
    // Resellers and competitors: live site forces isAffiliateOpen=false for these types
    // (useCopyCode.ts line 105), meaning the double-tab flow always runs on every click.
    // data-no-gate="1" replicates this — bypasses the session dedup entirely.
    var noGate=btn.dataset.noGate==='1';
    var popunderKey=btn.dataset.overrideAffiliateUrl?affiliateUrl:pageMerchantId;

    // 3. Fire promotion click on every Show Code intent — matches SC web CouponCard behaviour
    //    where trackPromotionClick() fires unconditionally on every copy click.
    //    WHY outside clipboard .then() and outside the affiliate-gate: clipboard can be denied
    //    and the affiliate may already be open (second+ click path goes straight to showModal).
    //    keepalive:true ensures the request survives page navigation.
    var _promoNumId=parseInt(promoId,10);
    if(_promoNumId&&pageMerchantId){
      var _clickType=(btn.dataset.couponId||'').indexOf('su-')===0?'su_code':'promotion';
      fetch('https://api.simplycodes.com/v2/promotion/clicks',{
        method:'POST',
        headers:{'Content-Type':'application/json','x-source':'scmdp'},
        body:JSON.stringify({type:_clickType,promotionId:_promoNumId,merchantId:pageMerchantId}),
        keepalive:true
      }).catch(function(){});
    }

    if(affiliateUrl&&(noGate||!window._scOpenedAffiliates.has(popunderKey))){
      var mlpBase=btn.dataset.mlpUrl?(location.origin+btn.dataset.mlpUrl):location.href.split('?')[0];
      var modalQs='?sc_modal=1'
        +'&sc_code='+encodeURIComponent(code)
        +'&sc_title='+encodeURIComponent(title)
        +'&sc_desc='+encodeURIComponent(description)
        +'&sc_logo='+encodeURIComponent(merchantLogo)
        +'&sc_merchant='+encodeURIComponent(merchantName)
        +'&sc_aff='+encodeURIComponent(affiliateUrl)
        +'&sc_mu='+encodeURIComponent(merchantUrl)
        +'&sc_restr='+encodeURIComponent(JSON.stringify(restrictions))
        +'&sc_ps='+encodeURIComponent(pageSection)
        +'&sc_ord='+encodeURIComponent(order||'')
        +'&sc_pk='+encodeURIComponent(promoId);
      // Derive section hash from closest ancestor section — mirrors live useCopyCode.ts
      // currentUrl.hash = pageSection, so popup auto-scrolls to the clicked section.
      var sectionEl=btn.closest('section[id]');
      var sectionHash=sectionEl?'#'+sectionEl.id:'';

      // Open blank popup (stays in background), then navigate it to MLP+modal
      var popup=window.open();
      // 4. Copy to clipboard — runs unconditionally whether popup succeeded or was blocked.
      //    Placed AFTER window.open() so the user gesture token is consumed by the popup
      //    first (clipboard.writeText is async and would exhaust the token if called first).
      if(code&&navigator.clipboard){
        navigator.clipboard.writeText(code).then(function(){
          btn.textContent='Copied!';
          setTimeout(function(){btn.textContent=code.toUpperCase();},1500);
        });
      }
      if(popup){
        // Only mark affiliate as opened when popup actually succeeds — matches live
        // useCopyCode.ts line 274: openAffiliate() inside if(windowRef !== null).
        // If popup is blocked we do NOT mark, so the next click retries the pop-under.
        if(!noGate)window._scOpenedAffiliates.add(popunderKey);
        popup.location.assign(mlpBase+modalQs+sectionHash);
        // Pop-under opened: current tab navigates to merchant
        window.location.href=affiliateUrl;
        return; // skip showing modal on this (departing) tab
      }
      // Popup blocked: fall through to show modal on current tab
    }

    // (clipboard write moved above — runs unconditionally after window.open())

    // 4. Show modal on current tab (popup blocked, or affiliate already opened this session)
    showModal({
      code:code,title:title,description:description,
      merchantLogo:merchantLogo,merchantName:merchantName,
      affiliateUrl:affiliateUrl,merchantUrl:merchantUrl,
      restrictions:restrictions,
      pageSection:pageSection,order:order,pk:promoId,
      health:health,healthScore:healthScore,codeType:codeType,discount:discount
    });
  });

  // On page load: if opened as the new MLP tab from a pop-under, read URL params,
  // open the modal, and reveal all code buttons once the DOM is fully parsed.
  (function checkModalOnLoad(){
    var p=new URLSearchParams(location.search);
    if(p.get('sc_modal')!=='1')return;
    var code=p.get('sc_code')||'';
    history.replaceState(null,'',location.pathname);
    var restrictions=[];
    try{restrictions=JSON.parse(p.get('sc_restr')||'[]');}catch(ex){}

    function revealAllAndShowModal(){
      // Reveal all codes first so they're visible when the modal is dismissed.
      revealAllCodes();
      var rawAff=p.get('sc_aff')||'';
      var rawMu=p.get('sc_mu')||'';
      showModal({
        code:code,
        title:p.get('sc_title')||code,
        description:p.get('sc_desc')||'',
        merchantLogo:p.get('sc_logo')||'',
        merchantName:p.get('sc_merchant')||'store',
        affiliateUrl:isSafeUrl(rawAff)?rawAff:'',
        merchantUrl:isSafeUrl(rawMu)?rawMu:'',
        restrictions:restrictions,
        pageSection:p.get('sc_ps')||'',
        order:parseInt(p.get('sc_ord')||'0',10)||null,
        pk:p.get('sc_pk')||''
      });
    }

    // Defer until DOM is fully parsed so all btn-show-code elements are available
    if(document.readyState==='loading'){
      document.addEventListener('DOMContentLoaded',revealAllAndShowModal);
    }else{
      revealAllAndShowModal();
    }
  })();
})();
