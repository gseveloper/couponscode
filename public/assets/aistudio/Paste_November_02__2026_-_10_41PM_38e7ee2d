          var laterBtn=document.getElementById('sc-modal-tp-later');
          if(laterBtn)laterBtn.addEventListener('click',function(){
            var m=document.getElementById('sc-post-click-modal');if(m)m.style.display='none';document.body.style.overflow='';
            if(Array.isArray(window.dataLayer))window.dataLayer.push({event:'tp_ask_dismissed',source:'mlp',merchant_slug:merchantSlugMlp});
