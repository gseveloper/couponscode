(function(){
  if(window._ccExpandInit)return;
  window._ccExpandInit=true;
  document.addEventListener('click',function(e){
    var btn=e.target.closest('[data-cc-expand]');
    if(!btn)return;
    e.stopPropagation();
    var id=btn.getAttribute('data-cc-expand');
    var content=document.getElementById(id);
    if(!content)return;
    // Derive open state from the content element itself — not from button attr,
    // so that the Close button (which lacks data-open) works correctly too.
    var isOpen=content.style.height==='auto';
    if(isOpen){
      content.style.height='0';
      content.style.opacity='0';
      content.style.overflow='hidden';
    } else {
      content.style.height='auto';
      content.style.opacity='1';
      content.style.overflow='visible';
    }
    // Update expand trigger button state (may differ from the clicked btn when Close btn is used)
    var trigger=document.querySelector('[data-cc-expand="'+id+'"][data-open]');
    if(trigger){
      var caret=trigger.querySelector('.cc-expand-caret');
      if(caret)caret.style.transform=isOpen?'':'rotate(180deg)';
      trigger.setAttribute('data-open',isOpen?'0':'1');
      trigger.setAttribute('aria-expanded',isOpen?'false':'true');
    }
  });
  document.addEventListener('keydown',function(e){
    if(e.key!=='Enter'&&e.key!==' ')return;
    var btn=e.target.closest('[data-cc-expand]');
    if(btn)btn.click();
  });
})();
</script>
<script>
(function(){
  if(window._activityShowMoreInit)return;
  window._activityShowMoreInit=true;
  var STEP=3;

  // Show more verifications
  document.addEventListener('click',function(e){
    var btn=e.target.closest('[data-activity-show-more]');
    if(!btn)return;
    e.stopPropagation();
    var sectionId=btn.getAttribute('data-activity-show-more');
    var section=document.getElementById(sectionId);
    if(!section)return;
    // Find all activity article entries inside this section
    var articles=Array.from(section.querySelectorAll('article[data-activity-index]'));
    // Reveal the next STEP hidden ones
    var revealed=0;
    for(var i=0;i<articles.length&&revealed<STEP;i++){
      var art=articles[i];
      if(art.style.display==='none'){
        art.style.display='grid';
        revealed++;
      }
    }
    // Hide button when all entries are visible; otherwise update label with remaining count
    var hiddenCount=articles.filter(function(a){return a.style.display==='none';}).length;
    if(hiddenCount===0){
      btn.style.display='none';
    } else {
      btn.textContent='Show '+hiddenCount+' more verification'+(hiddenCount===1?'':'s');
    }
  });

})();
</script>
<script>
(function() {
  var showMoreBtn = document.getElementById('codes-show-more');
  var showLessBtn = document.getElementById('codes-show-less');
  if (!showMoreBtn) return;
  var grid = document.getElementById('codes-grid');
  var allCards = grid ? Array.from(grid.querySelectorAll('[data-card-index]')) : [];
  var total = parseInt(showMoreBtn.dataset.total || '0', 10);
  var pageSize = parseInt(showMoreBtn.dataset.pageSize || '4', 10);
  var initial = parseInt(showMoreBtn.dataset.shown || '4', 10);
  var shown = initial;

  function updateButtons() {
    var remaining = total - shown;
    if (remaining <= 0) {
      showMoreBtn.style.display = 'none';
    } else {
      showMoreBtn.style.display = '';
      showMoreBtn.textContent = 'Show ' + Math.min(pageSize, remaining) + ' more';
    }
    showLessBtn.style.display = shown > initial ? '' : 'none';
  }

  showMoreBtn.addEventListener('click', function() {
    var toShow = Math.min(pageSize, total - shown);
    for (var i = shown; i < shown + toShow; i++) {
      if (allCards[i]) allCards[i].style.display = '';
    }
    shown += toShow;
    updateButtons();
  });

  showLessBtn.addEventListener('click', function() {
    for (var i = initial; i < allCards.length; i++) {
      if (allCards[i]) allCards[i].style.display = 'none';
    }
    shown = initial;
    updateButtons();
    grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
})();
</script>
<script>
(function(){
  if(window._scShowCodeInit)return;
  window._scShowCodeInit=true;

  // Browser-aware extension URL (mirrors simplycodes-url-mapper.ts getBrowserGroup)
  function getExtUrl(){
    var ua=navigator.userAgent.toLowerCase();
    if(/iphone|ipad|ipod/.test(ua))return 'https://apps.apple.com/us/app/simplycodes-coupons-rewards/id1538885494';
    if(/android/.test(ua))return 'https://play.google.com/store/apps/details?id=com.simplycodes.mobile';
    if(/edg\//.test(ua))return 'https://microsoftedge.microsoft.com/addons/detail/simplycodes-coupons-code/onkfibnhmkfjacdcodpdfdlmnhjleafm';
    if(/firefox\//.test(ua))return 'https://addons.mozilla.org/en-US/firefox/addon/simplycodes/';
    return 'https://chromewebstore.google.com/detail/simplycodes-verified-coup/gfkpklgmocbcbdabfellcnikamdaeajd';
  }

  function isSafeUrl(url){
    try{var s=new URL(url).protocol;return s==='https:'||s==='http:';}
    catch(e){return false;}
  }

  // Synchronous clipboard copy. The pop-under flow below navigates the current tab
  // (window.location.href = affiliateUrl) immediately after revealing a code, which
  // aborts the async navigator.clipboard.writeText() — so on the first click the
  // "Copied to your clipboard!" bubble showed but nothing actually landed on the
  // clipboard until the user clicked the modal Copy button (a clean second gesture).
  // execCommand('copy') is deprecated but synchronous and universally supported — the
  // correct tool for copy-then-navigate. Runs inside the click gesture, before any nav.
  function scCopySync(text){
    if(!text)return false;
    try{
      var ta=document.createElement('textarea');
      ta.value=text;
      ta.setAttribute('readonly','');
      ta.style.cssText='position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;';
      document.body.appendChild(ta);
      ta.focus();ta.select();ta.setSelectionRange(0,text.length);
      var ok=document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    }catch(e){return false;}
  }

  var modal=document.getElementById('sc-post-click-modal');
  var codeSection=modal&&document.getElementById('sc-modal-code-section');
  var appPromo=modal&&document.getElementById('sc-modal-app-promo');
  var modalCode=modal&&document.getElementById('sc-modal-code');
  var modalTitle=modal&&document.getElementById('sc-modal-title');
  var modalLogo=modal&&document.getElementById('sc-modal-logo');
  var ctaWrap=modal&&document.getElementById('sc-modal-cta-wrap');
  var clipboardBubble=modal&&document.getElementById('sc-modal-clipboard-bubble');
  var codePill=modal&&document.getElementById('sc-modal-code-pill');
  var voteSection=modal&&document.getElementById('sc-modal-vote-section');
  var tpSection=modal&&document.getElementById('sc-modal-tp-section');
  var currentShopClickData=null;

  function closeModal(){
    if(!modal)return;
    modal.style.display='none';
    document.body.style.overflow='';
  }

  function openModal(){
    if(!modal)return;
    modal.style.display='flex';
    document.body.style.overflow='hidden';
  }

  /**
   * Populate and open the post-click modal with the given code data.
   * Used both by the Show Code click handler and by the page-load param check.
   */
  function showModal(d){
    // d: { code, title, description, merchantLogo, merchantName, affiliateUrl, merchantUrl, restrictions[] }
    if(!modal)return;

    // Reset to CODE state
    if(codeSection)codeSection.style.display='block';
    if(appPromo)appPromo.style.display='none';
    if(tpSection)tpSection.style.display='none';

    // Logo
    if(modalLogo){
      if(d.merchantLogo){
        modalLogo.innerHTML='<img src="'+d.merchantLogo.replace(/"/g,'&quot;')+'" alt="'+d.merchantName.replace(/"/g,'&quot;')+' logo" style="width:100%;height:100%;object-fit:contain;" loading="lazy" />';
        modalLogo.style.display='flex';
      }else{
        modalLogo.style.display='none';
      }
    }

    // Title + subtitle
    if(modalTitle)modalTitle.textContent=d.title;
    var subtitle=document.getElementById('sc-modal-subtitle');
    if(subtitle){
      var subtitleText=d.description&&d.description!==d.title?d.description:'';
      subtitle.textContent=subtitleText;
      subtitle.style.display=subtitleText?'block':'none';
    }

    // Code — show/hide code-specific elements based on whether a code exists
    var hasCode=!!(d.code&&d.code.trim());
    if(modalCode)modalCode.textContent=hasCode?d.code.toUpperCase():'';
    if(clipboardBubble)clipboardBubble.style.display=hasCode?'inline-block':'none';
    if(codePill)codePill.style.display=hasCode?'flex':'none';
    if(voteSection)voteSection.style.display=hasCode?'block':'none';

    // Restrictions — only meaningful for codes
    var restrictionsEl=document.getElementById('sc-modal-restrictions');
    var restrictionsList=document.getElementById('sc-modal-restrictions-list');
    if(restrictionsEl&&restrictionsList){
      if(hasCode&&d.restrictions&&d.restrictions.length>0){
        restrictionsList.innerHTML=d.restrictions.map(function(r){
          return '<li>'+String(r).replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</li>';
        }).join('');
        restrictionsEl.style.display='block';
      }else{
        restrictionsEl.style.display='none';
      }
    }

    // CTA — affiliate redirect URL (validate scheme to block javascript: injection)
    var ctaHref=(isSafeUrl(d.affiliateUrl)?d.affiliateUrl:'')
      ||(isSafeUrl(d.merchantUrl)?d.merchantUrl:'')||'#';
    if(ctaWrap)ctaWrap.innerHTML='<a id="sc-modal-cta" href="'+ctaHref.replace(/"/g,'&quot;')+'" target="_blank" rel="noopener" style="display:block;background:#03FF88;color:#000;border-radius:12px;padding:12px;font-size:16px;font-weight:600;text-decoration:none;text-align:center;width:100%;box-sizing:border-box;">Shop at '+d.merchantName.replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</a>';

    modal.dataset.code=d.code;
    currentShopClickData={pk:d.pk||'',code:d.code||'',merchantName:d.merchantName||'',merchantUrl:d.merchantUrl||'',title:d.title||'',description:d.description||'',pageSection:d.pageSection||'reveal-code-modal',order:d.order||null,health:d.health||'',healthScore:d.healthScore||'',codeType:d.codeType||'Regular',discount:d.discount||d.title||''};
    openModal();
  }

  if(modal){
    var closeBtn=document.getElementById('sc-modal-close');
    if(closeBtn)closeBtn.addEventListener('click',closeModal);
    modal.addEventListener('click',function(e){if(e.target===modal)closeModal();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&modal.style.display==='flex')closeModal();});

    // Shop CTA click → fire shop_click_to_merchant before navigation
    if(ctaWrap)ctaWrap.addEventListener('click',function(ev){
      if(!ev.target.closest('a'))return;
      if(!currentShopClickData)return;
      var layoutEl2=document.querySelector('[data-component="mlp-v2-layout"]');
      var mid=parseInt(layoutEl2&&layoutEl2.dataset.merchantId||'0',10);
      if(Array.isArray(window.dataLayer)){window.dataLayer.push({event:'shop_click_to_merchant',merchant_id:mid,pk:currentShopClickData.pk,code:currentShopClickData.code,merchant_name:currentShopClickData.merchantName,merchant_url:currentShopClickData.merchantUrl,coupon_title:currentShopClickData.title,coupon_description:currentShopClickData.description,page_section:currentShopClickData.pageSection,order:currentShopClickData.order});}
      currentShopClickData=null;
    });

    // Vote buttons (inside modal, delegate)
    modal.addEventListener('click',function(e){
      var btn=e.target.closest('[data-vote]');
      if(!btn)return;
      var vote=btn.dataset.vote;
      if(codeSection)codeSection.style.display='none';
      if(appPromo)appPromo.style.display='block';
      currentShopClickData=null;

      // First vote this session → Trustpilot review-ask (universal — yes and no)
      // tpSection is null when TP_ASK_ROLLOUT gates this user out; skip the entire branch.
      if(tpSection&&!sessionStorage.getItem('sc_tp_shown')){
        sessionStorage.setItem('sc_tp_shown','1');
        if(appPromo)appPromo.style.display='none';
        tpSection.style.display='block';
        var tpSubEl=document.getElementById('sc-modal-tp-sub');
        if(tpSubEl)tpSubEl.textContent=vote==='yes'?'A 30-second Trustpilot review tells them what worked.':'A 30-second Trustpilot review tells them what to skip.';
        var merchantSlugMlp=window.location.pathname.split('/').filter(Boolean)[0]||'';
        if(Array.isArray(window.dataLayer))window.dataLayer.push({event:'tp_ask_shown',source:'mlp',merchant_slug:merchantSlugMlp});
        if(ctaWrap){
          ctaWrap.innerHTML='<a href="https://www.trustpilot.com/review/simplycodes.com?utm_source=mlp&utm_medium=post-click-modal&utm_campaign=universal-tp-ask" target="_blank" rel="noopener noreferrer" data-gtm-selector="mcp-tp-review-ask" data-track="tp_review_cta_click" data-section="tp_ask_modal" style="display:block;background:#00b67a;color:#fff;border-radius:12px;padding:12px;font-size:16px;font-weight:600;text-decoration:none;text-align:center;width:100%;box-sizing:border-box;margin-bottom:8px;">Leave a review</a>'
            +'<button id="sc-modal-tp-later" style="display:block;width:100%;background:none;border:none;color:#71717a;font-size:13px;cursor:pointer;padding:6px;">Maybe later</button>';
