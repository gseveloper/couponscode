  function openModal(src,alt,meta){
    img.style.display='none';
    img.src='';
    img.alt=alt||'Screenshot';
    spinner.style.display='block';
    spinner.textContent='Loading…';
    if(meta&&meta.user){
      usernameEl.textContent=meta.user;
      timeEl.textContent=meta.time||'';
      if(meta.iso)timeEl.setAttribute('datetime',meta.iso);
      if(meta.desc){descEl.textContent=meta.desc;descEl.style.display='block';}
      else{descEl.style.display='none';}
      var initials=(meta.user||'').trim().split(' ').filter(Boolean).map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase()||'?';
      avatarEl.innerHTML='';
      if(meta.avatar){
        var aImg=document.createElement('img');
        aImg.src=meta.avatar;
        aImg.alt='';
        aImg.style.cssText='width:100%;height:100%;object-fit:cover;';
        aImg.onerror=function(){avatarEl.textContent=initials;};
        avatarEl.appendChild(aImg);
      } else {
        avatarEl.textContent=initials;
      }
      header.style.display='block';
